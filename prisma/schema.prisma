generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────
// Core entities
// ──────────────────────────────────────

model School {
  id               String   @id @default(cuid())
  name             String
  principalName    String?
  principalPhone   String?
  periodCount      Int      @default(10)
  dayCount         Int      @default(6)
  periodStartTimes String?  // JSON: ["07:45","08:30",...] (legacy)
  periodTimes      String?  // JSON: [{"start":"07:45","end":"08:30"},...]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users          User[]
  teachers       Teacher[]
  classes        Class[]
  rooms          Room[]
  subjects       Subject[]
  constraints    SchoolConstraint[]
  layers         Layer[]
  roomCategories RoomCategory[]
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  name     String
  password String
  role     String @default("STAFF")
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Teacher {
  id                  String  @id @default(cuid())
  name                String
  email               String?
  phone               String?
  gender              String  @default("UNSPECIFIED") // MALE | FEMALE | UNSPECIFIED
  maxHoursPerWeek     Int?
  considerationPercent Int    @default(0) // 0-100 deducted from maxHoursPerWeek
  personalSituation   String? // optional free text
  schoolId            String
  school              School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  subjects        TeacherSubject[]
  slots           TimetableSlot[]
  constraints     TeacherConstraint[]
  absences        Absence[]
  studyGroups     StudyGroup[]
  homeroomClass   Class?               @relation("HomeRoom")
  substitutions   Substitution[]       @relation("SubstituteTeacher")
  excludedClasses TeacherExcludedClass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id           String @id @default(cuid())
  name         String
  grade        Int
  studentCount Int    @default(0)
  schoolId     String
  school       School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  homeroomTeacherId String?  @unique
  homeroomTeacher   Teacher? @relation("HomeRoom", fields: [homeroomTeacherId], references: [id], onDelete: SetNull)

  layerId String?
  layer   Layer?  @relation(fields: [layerId], references: [id], onDelete: SetNull)

  slots             TimetableSlot[]
  studyGroupLinks   StudyGroupClass[]
  mergedInto        Substitution[]           @relation("MergedClass")
  requirements      ClassSubjectRequirement[]
  excludingTeachers TeacherExcludedClass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClassSubjectRequirement {
  id           String  @id @default(cuid())
  classId      String
  class        Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  hoursPerWeek Int     @default(1)

  @@unique([classId, subjectId])
}

model Room {
  id                   String @id @default(cuid())
  name                 String
  capacity             Int    @default(40)
  type                 String @default("REGULAR")
  maxConcurrentClasses Int    @default(1)
  schoolId             String
  school               School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  categoryId String?
  category   RoomCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  slots  TimetableSlot[]
  layers LayerRoom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subject {
  id            String  @id @default(cuid())
  name          String
  category      String?
  requiredHours String?
  color         String?
  schoolId      String
  school        School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  teachers     TeacherSubject[]
  slots        TimetableSlot[]
  studyGroups  StudyGroup[]
  requirements ClassSubjectRequirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeacherSubject {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
}

// ──────────────────────────────────────
// Timetable
// ──────────────────────────────────────

model TimetableSlot {
  id     String @id @default(cuid())
  day    Int
  period Int

  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  roomId    String?
  room      Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  studyGroupId String?
  studyGroup   StudyGroup? @relation(fields: [studyGroupId], references: [id], onDelete: SetNull)

  @@unique([day, period, classId])
  @@unique([day, period, teacherId])
  @@index([day, period, roomId])
}

// ──────────────────────────────────────
// Study Groups
// ──────────────────────────────────────

model StudyGroup {
  id        String  @id @default(cuid())
  name      String
  level     String?
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  classes StudyGroupClass[]
  slots   TimetableSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudyGroupClass {
  id           String     @id @default(cuid())
  studyGroupId String
  studyGroup   StudyGroup @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)
  classId      String
  class        Class      @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studyGroupId, classId])
}

// ──────────────────────────────────────
// Constraints
// ──────────────────────────────────────

model TeacherConstraint {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  type      String
  day       Int?
  period    Int?
  note      String?

  createdAt DateTime @default(now())
}

model SchoolConstraint {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  type     String
  config   String

  createdAt DateTime @default(now())
}

// ──────────────────────────────────────
// Absences & Substitutions
// ──────────────────────────────────────

model Absence {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date      String
  periods   String
  reason    String
  note      String?
  status    String  @default("UNRESOLVED")

  substitutions Substitution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, date])
}

model SuperAdmin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
}

model Substitution {
  id           String  @id @default(cuid())
  absenceId    String
  absence      Absence @relation(fields: [absenceId], references: [id], onDelete: Cascade)
  period       Int
  solutionType String

  substituteTeacherId String?
  substituteTeacher   Teacher? @relation("SubstituteTeacher", fields: [substituteTeacherId], references: [id], onDelete: SetNull)
  mergedWithClassId   String?
  mergedWithClass     Class?   @relation("MergedClass", fields: [mergedWithClassId], references: [id], onDelete: SetNull)
  swapDetails         String?
  notes               String?

  createdAt DateTime @default(now())
}

// ──────────────────────────────────────
// Layers, Room Categories, Exclusions
// ──────────────────────────────────────

model Layer {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes      Class[]
  allowedRooms LayerRoom[]

  @@unique([schoolId, name])
}

model LayerRoom {
  layerId String
  layer   Layer  @relation(fields: [layerId], references: [id], onDelete: Cascade)
  roomId  String
  room    Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([layerId, roomId])
}

model RoomCategory {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  order    Int    @default(0)

  rooms Room[]

  @@unique([schoolId, name])
}

model TeacherExcludedClass {
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  reason    String?

  @@id([teacherId, classId])
}

model MifrasPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     String   @default("")
  parentId    String?
  parent      MifrasPage?  @relation("SubPages", fields: [parentId], references: [id], onDelete: SetNull)
  children    MifrasPage[] @relation("SubPages")
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
